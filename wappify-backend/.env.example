NODE_ENV=development
PORT=8080
DASHBOARD_URL=http://localhost:3000

# Supabase / PostgreSQL. Use fresh values from the Supabase Connect panel.
DATABASE_URL="postgresql://postgres.project_ref:password@aws-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.project_ref.supabase.co:5432/postgres?sslmode=require"
REDIS_URL=redis://localhost:6379

# Twilio WhatsApp API. Use the sender number configured in Twilio in E.164 form.
TWILIO_ACCOUNT_SID=ACreplace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_WHATSAPP_NUMBER=14155238886
# Must exactly match the HTTPS "When a message comes in" URL in Twilio.
TWILIO_WEBHOOK_URL=https://your-backend-domain/api/webhooks/whatsapp

# Shared secret used only by the dashboard server to request outgoing messages.
BACKEND_INTERNAL_API_TOKEN=replace_with_a_long_random_secret

# AI
GEMINI_API_KEY=replace_me

# The demo seed is opt-in and is disabled in production.
ENABLE_DEMO_SEED=false


